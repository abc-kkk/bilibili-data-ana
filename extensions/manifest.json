{
  "manifest_version": 3,
  "name": "B站UP主视频报告",
  "version": "5.0",
  "description": "自动读取B站登录状态，一键分析UP主视频数据并下载CSV报告。",
  "permissions": [
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "*://*.bilibili.com/"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "B站UP主视频报告"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}